# Copy to .env and adjust. .env is gitignored; nothing here is a real secret.

# Bootstrap superuser. Flyway connects as this; the application does not.
POSTGRES_DB=pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

# Password V7 assigns to pipeline_app, the role Spring's datasource uses.
APP_DB_PASSWORD=pipeline_app

# Presented as X-API-Key on every /api request. There is no default: the application
# will not start without one, which is preferable to shipping a key everybody knows.
API_KEY=change-me-local-only

# Stamped on every stage_event as actor_id and actor_name.
RECRUITER_ID=recruiter-1
RECRUITER_NAME=Asha Menon

# "redis" for a bucket shared across instances, "memory" for an in-process one.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_WRITE=20
RATE_LIMIT_READ=300
RATE_LIMIT_SEARCH=60
RATE_LIMIT_WINDOW=1m
REDIS_HOST=redis
REDIS_PORT=6379

# ecs, logstash, gelf, or empty for human-readable lines while developing.
LOG_FORMAT=ecs

# Backdated demo data. Pin SEED_BASE_INSTANT to reproduce a screenshot exactly;
# left blank, the seeder uses today so the recency guarantees stay true.
SEED_ENABLED=true
SEED_CANDIDATES=200
SEED_BASE_INSTANT=
